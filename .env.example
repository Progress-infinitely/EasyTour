# ==========================================================
# 1. 远程模型基础配置
# ==========================================================
# OPENAI_API_KEY：远程模型服务的访问密钥。
# 这个项目里的 LLM、embedding、rerank 等远程能力，都需要它。
OPENAI_API_KEY=

# OPENAI_API_BASE：远程模型服务地址。
# 文本模型调用通常会走这里。
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM_DEFAULT_MODEL：默认文本模型名。
# 主体识别、HyDE 生成、最终答案生成，通常都会用到它。
LLM_DEFAULT_MODEL=qwen-flash

# VL_MODEL：视觉模型名。
# 主要给 Markdown 图片处理节点用来生成图片摘要。
VL_MODEL=qwen3-vl-flash


# ==========================================================
# 2. PDF 解析配置（MinerU）
# ==========================================================
# MINERU_API_KEY：MinerU 的访问密钥。
# 如果你要导入 PDF，这个很重要，因为 PDF 需要先转成 Markdown。
MINERU_API_KEY=

# MINERU_API_BASE：MinerU 接口地址。
MINERU_API_BASE=https://mineru.net/api/v4

# MINERU_MODEL_VERSION：MinerU 解析模式或版本。
# 一般保持当前值即可。
MINERU_MODEL_VERSION=vlm


# ==========================================================
# 3. 本地中间件：Milvus / MinIO / Mongo
# ==========================================================
# MILVUS_URL：Milvus 向量数据库地址。
# 导入链会把 chunk 向量写进去，查询链会从这里做相似度检索。
MILVUS_URL=http://127.0.0.1:19530

# MINIO_ENDPOINT：MinIO 地址。
# 原始文件、图片等对象会存这里。
MINIO_ENDPOINT=127.0.0.1:9000

# MINIO_ACCESS_KEY：MinIO 登录账号。
MINIO_ACCESS_KEY=minioadmin

# MINIO_SECRET_KEY：MinIO 登录密码。
MINIO_SECRET_KEY=minioadmin

# MINIO_BUCKET_NAME：MinIO 桶名。
MINIO_BUCKET_NAME=easytour-assets-v1

# MINIO_SECURE：是否通过 HTTPS 访问 MinIO。
# false = HTTP，true = HTTPS。
MINIO_SECURE=false

# MONGO_URL：Mongo 数据库地址。
# 聊天历史默认会优先存到 Mongo。
MONGO_URL=mongodb://admin:123456@127.0.0.1:27017

# MONGO_DB_NAME：Mongo 数据库名。
MONGO_DB_NAME=easytour_v1

# CHUNKS_COLLECTION / ITEM_NAME_COLLECTION：
CHUNKS_COLLECTION=easytour_chunks_v1
ITEM_NAME_COLLECTION=easytour_item_names_v1


# ==========================================================
# 4. 向量化相关配置
# ==========================================================
# EMBEDDING_DIM：向量维度。
# 必须和远程 embedding 模型输出维度一致，也要和 Milvus 集合结构一致。
EMBEDDING_DIM=1024

# EMBEDDING_MODEL：embedding 模型名。
# 它负责把文本转成向量。
EMBEDDING_MODEL=text-embedding-v4

# EMBEDDING_PROVIDER：embedding 提供方。
# 当前项目一般保持 dashscope 即可。
EMBEDDING_PROVIDER=dashscope


# ==========================================================
# 5. 联网搜索增强（可选）
# ==========================================================
# ENABLE_WEB_SEARCH：是否启用联网搜索增强。
# true 表示查询链会额外调用 WebSearch MCP（通过 Streamable HTTP 传输）。
ENABLE_WEB_SEARCH=true

# MCP_DASHSCOPE_BASE_URL：联网搜索 MCP 服务地址。
# 当前应使用 /mcp 结尾的 Streamable HTTP 地址。
# 如果仍写旧版 /sse 地址，代码里会自动兼容转换成 /mcp。
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp


# ==========================================================
# 6. FastAPI 服务启动配置
# ==========================================================
# KNOWLEDGE_API_HOST：服务监听地址。
KNOWLEDGE_API_HOST=0.0.0.0

# KNOWLEDGE_API_PORT：服务监听端口。
KNOWLEDGE_API_PORT=8000
